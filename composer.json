{
    "name": "osamanagi/filament-daisy-ui-theme-switcher",
    "description": "Integrating Daisy UI theme switcher to Filament apps",
    "keywords": [
        "osamanagi",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "filament-daisy-ui-theme-switcher"
    ],
    "homepage": "https://github.com/osamanagi/filament-daisy-ui-theme-switcher",
    "support": {
        "issues": "https://github.com/osamanagi/filament-daisy-ui-theme-switcher/issues",
        "source": "https://github.com/osamanagi/filament-daisy-ui-theme-switcher"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "osamanagi",
            "email": "osamanagiworks@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "pestphp/pest-plugin-livewire": "^3.0|^4.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Osamanagi\\FilamentDaisyUiThemeSwitcher\\": "src/",
            "Osamanagi\\FilamentDaisyUiThemeSwitcher\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Osamanagi\\FilamentDaisyUiThemeSwitcher\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "lint": "pint",
        "refactor": "rector",
        "test": "pest",
        "test:lint": "pint --test",
        "test:refactor": "rector --dry-run"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Osamanagi\\FilamentDaisyUiThemeSwitcher\\FilamentDaisyUiThemeSwitcherServiceProvider"
            ],
            "aliases": {
                "FilamentDaisyUiThemeSwitcher": "Osamanagi\\FilamentDaisyUiThemeSwitcher\\Facades\\FilamentDaisyUiThemeSwitcher"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}